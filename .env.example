# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Ключ GigaChat (обязателен только для ИИ-функций)
GIGACHAT_CREDENTIALS=

# Пароль администратора (необязательно)
ADMIN_PASSWORD=

# Порт сервера (по умолчанию 3000)
PORT=3000

# Ссылка на таблицу кураторов (необязательно)
CURATOR_SHEET_URL=

# Дополнительные адреса для CORS через запятую (необязательно)
CORS_ORIGINS=

# Свои пути к данным и папкам (необязательно)
# DATA_FILE=
# FEEDBACK_DIR=
# PRESENTATION_DIR=
# STATUS_DIR=
